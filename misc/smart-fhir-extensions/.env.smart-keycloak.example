SMART_KEYCLOAK_IMAGE=smart-keycloak-local:dev
SMART_KEYCLOAK_CONTAINER_NAME=smart-keycloak-local
SMART_KEYCLOAK_HTTP_PORT=8080
KC_HTTP_ENABLED=true

SMART_FHIR_IMAGE=fhir-server-local:dev
SMART_FHIR_CONTAINER_NAME=smart-fhir-local
SMART_FHIR_HTTP_PORT=8081
START_LOCAL_FHIR=true

# FHIR Server Database (Supabase - can be a separate project from Keycloak)
# JNDI name in server.xml: jdbc/fhir-default_default
FHIR_DB_HOST=db.example.supabase.co
FHIR_DB_PORT=5432
FHIR_DB_NAME=postgres
FHIR_DB_SCHEMA=fhirdata
FHIR_DB_USER=postgres
FHIR_DB_PASS=change-me
FHIR_DB_SSL_MODE=require

# Set this to misc/smart-fhir-extensions/docker-compose.lfh-override.yml when you want
# Keycloak to point at a running LinuxForHealth FHIR server instead of the local HAPI container.
SMART_KEYCLOAK_COMPOSE_OVERRIDE_FILE=

# Optional helper path: instead of editing KC_DB_HOST / KC_DB_USERNAME manually,
# run ./misc/smart-fhir-extensions/smart-keycloak.sh set-session-conn 'postgres://...'
# with the Supabase session-mode connection string from Dashboard -> Connect.

KC_BOOTSTRAP_ADMIN_USERNAME=test_admin@healthcare
KC_BOOTSTRAP_ADMIN_PASSWORD=Duhxo3-wecbof-wycvoc

SMART_REALM=smart
SMART_CLIENT_ID=smart-launch-client
SMART_CLIENT_REDIRECT_URI=http://localhost:3000/*

# ABAC naming defaults (documentation/alignment values).
# Keycloak template maps token claims from user attributes:
#   tenant_id <- tenantId
#   org_id <- orgId
#   purpose_of_use <- purposeOfUse
# FHIR ABAC default label systems:
#   https://linuxforhealth.org/fhir/abac/tenant
#   https://linuxforhealth.org/fhir/abac/org
ABAC_USER_ATTR_TENANT=tenantId
ABAC_USER_ATTR_ORG=orgId
ABAC_USER_ATTR_PURPOSE=purposeOfUse
ABAC_CLAIM_TENANT=tenant_id
ABAC_CLAIM_ORG=org_id
ABAC_CLAIM_PURPOSE=purpose_of_use
ABAC_RESOURCE_TENANT_SYSTEM=https://linuxforhealth.org/fhir/abac/tenant
ABAC_RESOURCE_ORG_SYSTEM=https://linuxforhealth.org/fhir/abac/org
ABAC_ALLOWED_PURPOSES=TREAT,HPAYMT,HOPERAT

FHIR_BASE_URL=http://localhost:8081/fhir-server/api/v4
INTERNAL_FHIR_URL=http://fhir:9080/fhir-server/api/v4

# Use the direct Supabase Postgres endpoint only when your environment supports IPv6.
# If Docker cannot resolve db.<project-ref>.supabase.co, switch this to the Supavisor
# session-mode host from the Supabase dashboard and set KC_DB_USERNAME to postgres.<project-ref>.
KC_DB_HOST=db.example.supabase.co
KC_DB_PORT=5432
KC_DB_DATABASE=postgres
KC_DB_SCHEMA=keycloak
KC_DB_USERNAME=postgres
KC_DB_PASSWORD=change-me
KC_DB_SSL_MODE=require
INIT_KEYCLOAK_SCHEMA=true